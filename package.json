{
  "name": "deepseek-harness-desktop",
  "version": "0.3.1",
  "description": "An unofficial desktop wrapper for DeepSeek Harness.",
  "type": "module",
  "main": "src/main.js",
  "author": {
    "name": "Krystal Cao",
    "email": "jerry.caocc@liunian.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krystal-cao/deepseek-harness-desktop.git"
  },
  "homepage": "https://github.com/krystal-cao/deepseek-harness-desktop",
  "bugs": {
    "url": "https://github.com/krystal-cao/deepseek-harness-desktop/issues"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check:upstream": "node scripts/check-upstream.mjs",
    "bump:dsh": "node scripts/bump-dsh.mjs",
    "postinstall": "node scripts/prepare-dependencies.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "verify:inset": "node scripts/verify-inset.mjs",
    "clean:dist": "node scripts/clean-dist.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "npm run dist:mac:arm64",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:all": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64 --publish never"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.7",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.7",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.0.12",
    "pnpm": "^11.22.0"
  },
  "build": {
    "afterSign": "scripts/after-pack.cjs",
    "appId": "io.github.krystal-cao.deepseek-harness-desktop",
    "productName": "DeepSeek Harness",
    "artifactName": "DeepSeek-Harness-Desktop-${version}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "krystal-cao",
      "repo": "deepseek-harness-desktop"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*",
      "assets/bin/**/*",
      "assets/dsh-desktop-host/**/*"
    ],
    "files": [
      "src/**/*",
      "config/**/*",
      "assets/icon.png",
      "assets/dsh-desktop-host/**/*",
      "assets/bin/**/*",
      "!node_modules/pnpm",
      "package.json",
      "LICENSE",
      "third-party-licenses/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "DeepSeek Harness Desktop ${version}",
      "backgroundColor": "#f5f7fb",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 185
        },
        {
          "x": 400,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.0-rc.6": true,
    "@google/genai@1.52.0": true,
    "koffi@3.1.4": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.5": true
  }
}
